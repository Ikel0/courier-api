# This key is intentionally for local demonstration only. Rotate it before any deployment.
COURIER_API_KEYS=local:local_demo_key_change_me
COURIER_DATABASE_URL=sqlite:///./data/courier.db
COURIER_ALLOW_INSECURE_WEBHOOKS=false
COURIER_WEBHOOK_TIMEOUT_SECONDS=4
COURIER_RATE_LIMIT_PER_MINUTE=120
# Keep this on for the portfolio sandbox. Set false for a real deployment.
COURIER_ENABLE_DEMO_KEYS=true
# Optional, useful for a public portfolio deployment only.
COURIER_SEED_DEMO_DATA=false
